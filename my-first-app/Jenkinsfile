pipeline {
    agent any

    tools {
        nodejs 'NodeJS'          // Must match the name in Jenkins → Tools → NodeJS
    }

    environment {
        APP_NAME  = "my-first-app"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch:        'Raghupathi',
                    credentialsId: 'git_creds',
                    url:           'https://github.com/Locate360/Locate360-User-panel_dev.git'
            }
        }

        stage('Cleanup & Install') {
            steps {
                script {
                    sh '''
                        echo "Cleaning npm cache to avoid EINTEGRITY / corrupted tarball errors..."
                        npm cache clean --force

                        echo "Removing existing node_modules and lock file..."
                        rm -rf node_modules package-lock.json

                        echo "Installing packages..."
                        npm install
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'   // Must match Jenkins → Tools → SonarScanner
                    echo "Scanner path: ${scannerHome}"

                    withSonarQubeEnv('SonarQube') {         // Must match Jenkins → System → SonarQube servers
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=${APP_NAME} \
                                -Dsonar.sources=src \
                                -Dsonar.projectName=${APP_NAME}
                        """
                        // NOTE: -Dsonar.host.url and -Dsonar.login are injected
                        // automatically by withSonarQubeEnv — do NOT hard-code them here.
                    }
                }
            }
        }

        // ─────────────────────────────────────────────
        stage('Quality Gate') {
        // ─────────────────────────────────────────────
            steps {
                echo "Waiting for SonarQube Quality Gate result..."
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: Code passed all checks."
        }
        failure {
            echo "FAILURE: Pipeline failed. Check the logs above."
        }
        always {
            cleanWs()   // Optional: wipe workspace after every run to keep the agent clean
        }
    }
}
